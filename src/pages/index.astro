---
import { readFile } from "node:fs/promises";
import path from "node:path";
import ExposureBars from "../components/ExposureBars.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteIndexSchema } from "../lib/domain";
import { marketLabel } from "../lib/markets";
import {
  evaluationSchema,
  metricSetSchema,
  periodReportSchema,
  predictionSchema
} from "../lib/prediction-contract";
import { evaluationDisplayState } from "../lib/prediction-status";

const indexPath = path.join(process.cwd(), "public", "data", "index.json");
const index = siteIndexSchema.parse(JSON.parse(await readFile(indexPath, "utf8")));
const series = Object.fromEntries(
  await Promise.all(
    index.summaries.map(async ({ fund }) => [
      fund.id,
      JSON.parse(
        await readFile(
          path.join(process.cwd(), "public", "data", "series", `${fund.id}.json`),
          "utf8"
        )
      ) as Array<{
        date: string;
        nav: number | null;
        price: number | null;
        benchmarkPrice: number | null;
      }>
    ])
  )
);
const initial = index.summaries[0];
const initialPrediction = predictionSchema.nullable().parse(initial?.prediction ?? null);
const initialEvaluation = evaluationSchema.nullable().parse(initial?.evaluation ?? null);
const initialMetrics = metricSetSchema.nullable().parse(initial?.rollingMetrics ?? null);
const initialEvaluationDisplay = evaluationDisplayState(initialPrediction, initialEvaluation);
const reports = index.reports.map((report) => periodReportSchema.parse(report));

const percent = (value: number | null | undefined) =>
  value === null || value === undefined ? "—" : `${value >= 0 ? "+" : ""}${(value * 100).toFixed(2)}%`;
const number = (value: number | null | undefined, currency?: string) =>
  value === null || value === undefined
    ? "—"
    : new Intl.NumberFormat("zh-CN", {
        maximumFractionDigits: 2,
        ...(currency ? { style: "currency", currency } : {})
      }).format(value);
const assetTypeLabels = {
  stock: "股票",
  bond: "债券",
  fund: "基金",
  "target-etf": "目标 ETF"
};
const holdingChangeLabels = {
  new: "新增",
  exited: "退出",
  increased: "增加",
  decreased: "减少",
  unchanged: "不变",
  unavailable: "无法比较"
};
const initialHoldingQuotes = new Map(
  initial?.holdingQuotes?.quotes.map((quote) => [quote.assetKey, quote]) ?? []
);
---

<BaseLayout
  title="Fund Overwatch | 中国大陆基金分析"
  description="中国大陆真实基金预测、评估、周期复盘与持仓分析"
>
  <div class="ambient ambient-one"></div>
  <div class="ambient ambient-two"></div>
  <header class="site-header">
    <a class="brand" href={import.meta.env.BASE_URL}>
      <span class="brand-mark">FO</span>
      <span><strong>Fund Overwatch</strong><small>CHINA FUND ANALYTICS</small></span>
    </a>
    <div class="header-badges">
      <span class="badge success">仅真实公开数据</span>
      <span class:list={["badge", index.dataStatus === "complete" ? "success" : "warning"]}>
        <span class="status-dot"></span>{index.dataStatus === "complete" ? "数据完整" : "部分数据"}
      </span>
    </div>
  </header>

  <main>
    <section class="hero">
      <div>
        <p class="eyebrow">AUDITABLE PREDICTION LOOP</p>
        <h1>中国基金的<br /><span>预测与复盘。</span></h1>
        <p class="hero-copy">只跟踪 8 只中国大陆真实基金，以可解释基线完成上午预测、晚间评估、周期复盘与有界校准。</p>
      </div>
      <div class="update-card">
        <span>最近更新时间</span>
        <strong>{new Date(index.generatedAt).toLocaleString("zh-CN", { timeZone: "Asia/Shanghai" })}</strong>
        <small>北京时间 · {index.phase} 阶段 · 净值以来源实际披露为准</small>
      </div>
    </section>

    <section class="controls" aria-label="基金筛选">
      <label class="fund-select">
        <span>基金</span>
        <select id="fund-filter">
          {
            index.summaries.map(({ fund }) => (
              <option value={fund.id}>
                {fund.symbol} · {fund.name}
              </option>
            ))
          }
        </select>
      </label>
      <div class="universe-stat">
        <strong>{index.summaries.length}</strong>
        <span>只中国大陆真实基金</span>
      </div>
    </section>

    {
      initial ? (
        <div id="dashboard">
          <section class="fund-heading">
            <div>
              <div class="fund-title-line">
                <span id="fund-symbol">{initial.fund.symbol}</span>
                <h2 id="fund-name">{initial.fund.name}</h2>
              </div>
              <p id="fund-meta">
                {marketLabel(initial.fund.market)} · {initial.fund.exchange} · {initial.fund.assetClass} · 对标 {initial.fund.benchmark}
              </p>
              <p class="data-line"><span id="fund-data-badge" class="data-badge real">真实披露净值</span><span id="fund-as-of">净值截至 {initial.latestQuote?.date ?? "—"}</span></p>
            </div>
            <div class="price-block">
              <small>最新价格 / 净值</small>
              <strong id="fund-price">
                {number(
                  initial.latestQuote?.price ?? initial.latestQuote?.nav,
                  initial.fund.currency
                )}
              </strong>
              <span id="fund-day-return" class:list={{ positive: (initial.analytics?.returns.day ?? 0) >= 0 }}>
                {percent(initial.analytics?.returns.day)}
              </span>
            </div>
          </section>

          <section class="prediction-grid" aria-label="预测闭环">
            <article class="prediction-card">
              <p class="eyebrow">MORNING PREDICTION</p>
              <h3>最近上午预测</h3>
              <strong id="prediction-return">{percent(initialPrediction?.predictedReturn)}</strong>
              <dl>
                <div><dt>方向</dt><dd id="prediction-direction">{initialPrediction?.direction ?? "unavailable"}</dd></div>
                <div><dt>置信度</dt><dd id="prediction-confidence">{percent(initialPrediction?.confidence)}</dd></div>
                <div><dt>特征覆盖率</dt><dd id="prediction-coverage">{percent(initialPrediction?.featureCoverage)}</dd></div>
                <div><dt>目标交易日</dt><dd id="prediction-target">{initialPrediction?.targetTradeDate ?? "—"}</dd></div>
                <div><dt>模型</dt><dd id="prediction-model">{initialPrediction ? `${initialPrediction.modelVersion} · ${initialPrediction.modelStatus}` : "—"}</dd></div>
              </dl>
              <p id="prediction-explanation" class="card-note">{initialPrediction?.contributions.map(({ note }) => note).join("；") ?? initial.predictionAvailability.reason}</p>
            </article>
            <article class="prediction-card">
              <p class="eyebrow">EVENING EVALUATION</p>
              <h3>实际净值与误差</h3>
              <strong id="evaluation-actual">{percent(initialEvaluation?.actualReturn)}</strong>
              <dl>
                <div><dt>状态</dt><dd id="evaluation-status">{initialEvaluationDisplay.status}</dd></div>
                <div><dt>预测误差</dt><dd id="evaluation-error">{percent(initialEvaluation?.error)}</dd></div>
                <div><dt>实际净值区间</dt><dd id="evaluation-dates">{initialEvaluation?.actualStartDate && initialEvaluation.actualEndDate ? `${initialEvaluation.actualStartDate} → ${initialEvaluation.actualEndDate}` : initialPrediction ? "等待目标净值披露" : "—"}</dd></div>
                <div><dt>是否命中方向</dt><dd id="evaluation-direction">{initialEvaluation?.directionCorrect == null ? "—" : initialEvaluation.directionCorrect ? "是" : "否"}</dd></div>
              </dl>
              <p id="evaluation-reason" class="card-note">{initialEvaluationDisplay.reason}</p>
            </article>
            <article class="prediction-card">
              <p class="eyebrow">ROLLING METRICS</p>
              <h3>滚动评估</h3>
              <strong id="metric-accuracy">{percent(initialMetrics?.directionAccuracy)}</strong>
              <dl>
                <div><dt>样本数</dt><dd id="metric-samples">{initialMetrics?.sampleCount ?? 0}</dd></div>
                <div><dt>MAE</dt><dd id="metric-mae">{percent(initialMetrics?.mae)}</dd></div>
                <div><dt>RMSE</dt><dd id="metric-rmse">{percent(initialMetrics?.rmse)}</dd></div>
                <div><dt>平均误差</dt><dd id="metric-bias">{percent(initialMetrics?.meanError)}</dd></div>
              </dl>
              <p class="card-note">样本不足时明确处于 cold-start；模型稳健性需要长期真实样本验证。</p>
            </article>
          </section>

          <section class="metric-grid">
            {[
              ["近一周", "week"],
              ["近一月", "month"],
              ["近一年", "year"],
              ["年化波动率", "volatility"],
              ["最大回撤", "drawdown"],
              ["超额收益", "excess"]
            ].map(([label, key]) => (
              <article class="metric-card">
                <span>{label}</span>
                <strong data-metric={key}>
                  {key === "volatility"
                    ? percent(initial.analytics?.annualizedVolatility)
                    : key === "drawdown"
                      ? percent(initial.analytics?.maxDrawdown)
                      : key === "excess"
                        ? percent(initial.analytics?.excessReturn)
                        : percent(
                            initial.analytics?.returns[
                              key as "week" | "month" | "year"
                            ]
                          )}
                </strong>
              </article>
            ))}
          </section>

          <section class="chart-card compact">
            <div class="card-heading">
              <div><p class="eyebrow">PERIOD REVIEWS</p><h3>周 / 月 / 年复盘</h3></div>
              <span class="report-count">{reports.length} 份报告</span>
            </div>
            <div class="report-grid">
              {reports.length ? reports.slice(-6).reverse().map((report) => (
                <article class="report-card">
                  <strong>{report.periodKey} · {report.period}</strong>
                  <span>{report.status === "final" ? "已完成" : "暂定，等待最终 NAV"}</span>
                  <dl>
                    <div><dt>样本</dt><dd>{report.metrics.sampleCount}</dd></div>
                    <div><dt>方向准确率</dt><dd>{percent(report.metrics.directionAccuracy)}</dd></div>
                    <div><dt>MAE / RMSE</dt><dd>{percent(report.metrics.mae)} / {percent(report.metrics.rmse)}</dd></div>
                    <div><dt>缺失率</dt><dd>{percent(report.missingRate)}</dd></div>
                  </dl>
                </article>
              )) : <p class="empty-state">尚无完整周期报告；到达周/月/年 gate 后生成。</p>}
            </div>
          </section>

          <section class="chart-card">
            <div class="card-heading">
              <div><p class="eyebrow">PERFORMANCE</p><h3>价格与净值走势</h3></div>
              <div class="legend"><span class="fund-line">基金价格</span><span class="benchmark-line">基准（归一化）</span></div>
            </div>
            <div class="chart-wrap"><canvas id="performance-chart"></canvas></div>
          </section>

          <section class="detail-grid">
            <article class="chart-card compact">
              <div class="card-heading"><div><p class="eyebrow">SIGNALS</p><h3>移动均线</h3></div></div>
              <dl class="signal-list">
                <div><dt>20 日均线</dt><dd data-metric="ma20">{number(initial.analytics?.movingAverages.day20)}</dd></div>
                <div><dt>60 日均线</dt><dd data-metric="ma60">{number(initial.analytics?.movingAverages.day60)}</dd></div>
                <div><dt>基准年收益</dt><dd data-metric="benchmark">{percent(initial.analytics?.benchmarkReturn)}</dd></div>
                <div><dt>有效观测数</dt><dd data-metric="observations">{initial.analytics?.observations ?? 0}</dd></div>
              </dl>
            </article>
            <article class="chart-card compact holdings-card">
              <div class="card-heading holdings-heading">
                <div><p class="eyebrow">DISCLOSED HOLDINGS</p><h3>主要持仓</h3></div>
                <div class="holdings-as-of"><strong id="holdings-as-of">定期报告持仓，截至 {initial.holdings?.date ?? "—"}；非实时</strong><span id="holdings-previous">{initial.holdings?.previousDate ? `比较上期 ${initial.holdings.previousDate}` : "暂无上一披露期数据"}</span></div>
              </div>
              <div class="holdings-table-wrap">
                <table class="holdings-table">
                  <thead><tr>
                    <th><button type="button" data-holding-sort="assetType">类型</button></th>
                    <th><button type="button" data-holding-sort="name">标的</button></th>
                    <th><button type="button" data-holding-sort="dayChange">最新日涨跌</button></th>
                    <th><button type="button" data-holding-sort="weight">当前权重</button></th>
                    <th><button type="button" data-holding-sort="weightChange">较上期</button></th>
                  </tr></thead>
                  <tbody id="holdings-list">
                    {initial.holdings?.holdings.map((holding) => {
                      const quote = initialHoldingQuotes.get(`${holding.assetType}:${holding.symbol}`);
                      return (
                        <tr>
                          <td><span class={`asset-type ${holding.assetType}`}>{assetTypeLabels[holding.assetType]}</span></td>
                          <td><strong>{holding.name}</strong><small>{holding.symbol}{holding.sector ? ` · ${holding.sector}` : ""}</small></td>
                          <td><span class:list={{ positive: (quote?.dayChange ?? 0) >= 0, negative: (quote?.dayChange ?? 0) < 0 }}>{quote?.dayChange == null ? "未提供" : percent(quote.dayChange)}</span><small>{quote?.asOf ? quote.asOf.slice(0, 10) : quote?.status === "unavailable" ? "行情不可用" : ""}</small></td>
                          <td>{holding.weight == null ? "未披露" : `${(holding.weight * 100).toFixed(2)}%`}</td>
                          <td><span class={`change-status ${holding.changeStatus}`}>{holdingChangeLabels[holding.changeStatus]}</span><small>{holding.weightChange == null ? "—" : `${holding.weightChange >= 0 ? "+" : ""}${(holding.weightChange * 100).toFixed(2)} 个百分点`}</small></td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </article>
          </section>

          <section class="exposure-grid" id="exposure-grid">
            <ExposureBars title="行业暴露" items={initial.holdings?.sectors ?? []} />
            <ExposureBars title="国家 / 地域暴露" items={initial.holdings?.countries ?? []} />
          </section>
        </div>
      ) : (
        <section class="empty-state page-empty">
          <h2>暂无基金数据</h2>
          <p>请先运行数据生成任务，再重新构建站点。</p>
        </section>
      )
    }

    <aside class="notice">
      <strong>数据说明</strong>
      <p>基金实际 NAV 日涨跌、持仓标的行情与模型预测是三类不同数据。定期报告前十大持仓不等于完整组合；QDII、债券和场外资产缺少可靠上午行情时明确标记不可用并降低置信度，绝不以模拟值补齐。</p>
    </aside>
  </main>

  <footer>
    <span>Fund Overwatch · Data clarity over noise.</span>
    <strong>非投资建议</strong>
    <span>投资有风险，决策需谨慎。</span>
  </footer>

  <script id="dashboard-data" type="application/json" set:html={JSON.stringify({ index, series })}></script>
  <script>
    import Chart from "chart.js/auto";
    import type { Holding, HoldingQuoteBatch, HoldingsSnapshot, SiteIndex } from "../lib/domain";
    import type { FundPrediction, MetricSet, PredictionEvaluation } from "../lib/prediction-contract";
    import { evaluationDisplayState } from "../lib/prediction-status";

    type DashboardSummary = SiteIndex["summaries"][number] & {
      prediction: FundPrediction | null;
      evaluation: PredictionEvaluation | null;
      rollingMetrics: MetricSet | null;
    };
    type DashboardData = {
      index: Omit<SiteIndex, "summaries"> & { summaries: DashboardSummary[] };
      series: Record<string, Array<{ date: string; price: number | null; nav: number | null; benchmarkPrice: number | null }>>;
    };
    const source = document.querySelector<HTMLScriptElement>("#dashboard-data");
    const data = source ? (JSON.parse(source.textContent ?? "{}") as DashboardData) : null;
    const canvas = document.querySelector<HTMLCanvasElement>("#performance-chart");
    const fundSelect = document.querySelector<HTMLSelectElement>("#fund-filter");
    let chart: Chart | null = null;
    let currentFundId = fundSelect?.value ?? "";
    let holdingSort: "assetType" | "name" | "dayChange" | "weight" | "weightChange" = "weight";
    let holdingSortDirection: "asc" | "desc" = "desc";
    const clientAssetTypeLabels: Record<Holding["assetType"], string> = {
      stock: "股票",
      bond: "债券",
      fund: "基金",
      "target-etf": "目标 ETF"
    };
    const clientChangeLabels: Record<Holding["changeStatus"], string> = {
      new: "新增",
      exited: "退出",
      increased: "增加",
      decreased: "减少",
      unchanged: "不变",
      unavailable: "无法比较"
    };

    const formatPercent = (value: number | null | undefined) =>
      value == null ? "—" : `${value >= 0 ? "+" : ""}${(value * 100).toFixed(2)}%`;
    const formatNumber = (value: number | null | undefined, currency?: string) =>
      value == null
        ? "—"
        : new Intl.NumberFormat("zh-CN", {
            maximumFractionDigits: 2,
            ...(currency ? { style: "currency", currency } : {})
          }).format(value);

    function setText(selector: string, value: string) {
      const element = document.querySelector(selector);
      if (element) element.textContent = value;
    }

    const escapeHtml = (value: string) =>
      value.replace(/[&<>"']/g, (character) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;"
      })[character] ?? character);

    function renderHoldings(
      holdings: HoldingsSnapshot | null | undefined,
      holdingQuotes: HoldingQuoteBatch | null | undefined
    ) {
      const holdingsList = document.querySelector("#holdings-list");
      if (!holdingsList) return;
      setText("#holdings-as-of", `定期报告持仓，截至 ${holdings?.date ?? "—"}；非实时`);
      setText(
        "#holdings-previous",
        holdings?.previousDate ? `比较上期 ${holdings.previousDate}` : "暂无上一披露期数据"
      );
      const quoteByKey = new Map(
        holdingQuotes?.quotes.map((quote) => [quote.assetKey, quote]) ?? []
      );
      const rows = [...(holdings?.holdings ?? [])];
      const valueFor = (holding: Holding) => {
        if (holdingSort === "assetType") return clientAssetTypeLabels[holding.assetType];
        if (holdingSort === "name") return holding.name;
        if (holdingSort === "dayChange") {
          return quoteByKey.get(`${holding.assetType}:${holding.symbol}`)?.dayChange ?? -Infinity;
        }
        return holding[holdingSort] ?? -Infinity;
      };
      rows.sort((left, right) => {
        const leftValue = valueFor(left);
        const rightValue = valueFor(right);
        const compared =
          typeof leftValue === "string" && typeof rightValue === "string"
            ? leftValue.localeCompare(rightValue, "zh-CN")
            : Number(leftValue) - Number(rightValue);
        return holdingSortDirection === "asc" ? compared : -compared;
      });
      holdingsList.innerHTML = rows.length
        ? rows.map((holding) => {
            const quote = quoteByKey.get(`${holding.assetType}:${holding.symbol}`);
            const quoteStatus = quote?.status === "stale"
              ? `${quote.asOf?.slice(0, 10) ?? "—"} · 陈旧`
              : quote?.status === "available"
                ? quote.asOf?.slice(0, 10) ?? "—"
                : "行情不可用";
            const sector = holding.sector ? ` · ${escapeHtml(holding.sector)}` : "";
            const dayChange = quote?.dayChange == null ? "未提供" : formatPercent(quote.dayChange);
            const dayClass = quote?.dayChange == null ? "" : quote.dayChange >= 0 ? "positive" : "negative";
            const weight = holding.weight == null ? "未披露" : `${(holding.weight * 100).toFixed(2)}%`;
            const weightChange = holding.weightChange == null
              ? "—"
              : `${holding.weightChange >= 0 ? "+" : ""}${(holding.weightChange * 100).toFixed(2)} 个百分点`;
            return `<tr><td><span class="asset-type ${holding.assetType}">${clientAssetTypeLabels[holding.assetType]}</span></td><td><strong>${escapeHtml(holding.name)}</strong><small>${escapeHtml(holding.symbol)}${sector}</small></td><td><span class="${dayClass}">${dayChange}</span><small>${quoteStatus}</small></td><td>${weight}</td><td><span class="change-status ${holding.changeStatus}">${clientChangeLabels[holding.changeStatus]}</span><small>${weightChange}</small></td></tr>`;
          }).join("")
        : `<tr><td colspan="5" class="empty-state">暂无持仓数据</td></tr>`;
      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-holding-sort]")) {
        const active = button.dataset.holdingSort === holdingSort;
        button.closest("th")?.setAttribute(
          "aria-sort",
          active ? (holdingSortDirection === "asc" ? "ascending" : "descending") : "none"
        );
      }
    }

    function renderExposure(title: string, items: Array<{ name: string; weight: number }>) {
      const rows = items.length
        ? items.slice(0, 6).map((item) => `<div class="exposure-row"><div class="exposure-label"><span>${item.name}</span><strong>${(item.weight * 100).toFixed(1)}%</strong></div><div class="bar-track"><span style="width:${Math.min(item.weight * 100, 100)}%"></span></div></div>`).join("")
        : `<p class="empty-state">暂无暴露数据</p>`;
      return `<section class="exposure-card"><h3>${title}</h3><div class="exposure-list">${rows}</div></section>`;
    }

    function renderFund(fundId: string) {
      if (!data) return;
      const summary = data.index.summaries.find(({ fund }) => fund.id === fundId);
      if (!summary) return;
      const { fund, analytics, latestQuote, holdings } = summary;
      currentFundId = fundId;
      setText("#fund-symbol", fund.symbol);
      setText("#fund-name", fund.name);
      setText("#fund-meta", `中国大陆-CN · ${fund.exchange} · ${fund.assetClass} · 对标 ${fund.benchmark}`);
      setText("#fund-data-badge", "真实披露净值");
      setText("#fund-as-of", `净值截至 ${latestQuote?.date ?? "—"}`);
      setText("#fund-price", formatNumber(latestQuote?.price ?? latestQuote?.nav, fund.currency));
      setText("#fund-day-return", formatPercent(analytics?.returns.day));
      const values: Record<string, string> = {
        week: formatPercent(analytics?.returns.week),
        month: formatPercent(analytics?.returns.month),
        year: formatPercent(analytics?.returns.year),
        volatility: formatPercent(analytics?.annualizedVolatility),
        drawdown: formatPercent(analytics?.maxDrawdown),
        excess: formatPercent(analytics?.excessReturn),
        ma20: formatNumber(analytics?.movingAverages.day20),
        ma60: formatNumber(analytics?.movingAverages.day60),
        benchmark: formatPercent(analytics?.benchmarkReturn),
        observations: String(analytics?.observations ?? 0)
      };
      Object.entries(values).forEach(([key, value]) => setText(`[data-metric="${key}"]`, value));
      const prediction = summary.prediction;
      const evaluation = summary.evaluation;
      const evaluationDisplay = evaluationDisplayState(prediction, evaluation);
      const rolling = summary.rollingMetrics;
      setText("#prediction-return", formatPercent(prediction?.predictedReturn));
      setText("#prediction-direction", prediction?.direction ?? "unavailable");
      setText("#prediction-confidence", formatPercent(prediction?.confidence));
      setText("#prediction-coverage", formatPercent(prediction?.featureCoverage));
      setText("#prediction-target", prediction?.targetTradeDate ?? "—");
      setText("#prediction-model", prediction ? `${prediction.modelVersion} · ${prediction.modelStatus}` : "—");
      setText("#prediction-explanation", prediction?.contributions.map(({ note }) => note).join("；") ?? summary.predictionAvailability.reason);
      setText("#evaluation-actual", formatPercent(evaluation?.actualReturn));
      setText("#evaluation-status", evaluationDisplay.status);
      setText("#evaluation-error", formatPercent(evaluation?.error));
      setText("#evaluation-dates", evaluation?.actualStartDate && evaluation.actualEndDate ? `${evaluation.actualStartDate} → ${evaluation.actualEndDate}` : prediction ? "等待目标净值披露" : "—");
      setText("#evaluation-direction", evaluation?.directionCorrect == null ? "—" : evaluation.directionCorrect ? "是" : "否");
      setText("#evaluation-reason", evaluationDisplay.reason);
      setText("#metric-accuracy", formatPercent(rolling?.directionAccuracy));
      setText("#metric-samples", String(rolling?.sampleCount ?? 0));
      setText("#metric-mae", formatPercent(rolling?.mae));
      setText("#metric-rmse", formatPercent(rolling?.rmse));
      setText("#metric-bias", formatPercent(rolling?.meanError));

      renderHoldings(holdings, summary.holdingQuotes);
      const exposureGrid = document.querySelector("#exposure-grid");
      if (exposureGrid) {
        exposureGrid.innerHTML = renderExposure("行业暴露", holdings?.sectors ?? []) + renderExposure("国家 / 地域暴露", holdings?.countries ?? []);
      }
      renderChart(fundId);
    }

    function renderChart(fundId: string) {
      if (!data || !canvas) return;
      const points = data.series[fundId] ?? [];
      const benchmarkBase = points.find((point) => point.benchmarkPrice)?.benchmarkPrice ?? 1;
      const priceBase = points.find((point) => point.price ?? point.nav)?.price ?? points.find((point) => point.nav)?.nav ?? 1;
      chart?.destroy();
      chart = new Chart(canvas, {
        type: "line",
        data: {
          labels: points.map((point) => point.date),
          datasets: [
            {
              label: "基金价格",
              data: points.map((point) => point.price ?? point.nav),
              borderColor: "#65e6bb",
              backgroundColor: "rgba(101, 230, 187, .12)",
              fill: true,
              pointRadius: 0,
              borderWidth: 2,
              tension: 0.25
            },
            {
              label: "基准（基金价格归一化）",
              data: points.map((point) => point.benchmarkPrice == null ? null : point.benchmarkPrice / benchmarkBase * priceBase),
              borderColor: "#8aa4ff",
              pointRadius: 0,
              borderWidth: 1.5,
              borderDash: [5, 5],
              tension: 0.25
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { intersect: false, mode: "index" },
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: false }, ticks: { color: "#748d89", maxTicksLimit: 8 } },
            y: { grid: { color: "rgba(255,255,255,.06)" }, ticks: { color: "#748d89" } }
          }
        }
      });
    }

    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-holding-sort]")) {
      button.addEventListener("click", () => {
        const nextSort = button.dataset.holdingSort as typeof holdingSort;
        if (holdingSort === nextSort) {
          holdingSortDirection = holdingSortDirection === "asc" ? "desc" : "asc";
        } else {
          holdingSort = nextSort;
          holdingSortDirection = nextSort === "name" || nextSort === "assetType" ? "asc" : "desc";
        }
        if (!data) return;
        const summary = data.index.summaries.find(({ fund }) => fund.id === currentFundId);
        renderHoldings(summary?.holdings, summary?.holdingQuotes);
      });
    }
    fundSelect?.addEventListener("change", () => renderFund(fundSelect.value));
    if (fundSelect?.value) renderFund(fundSelect.value);
  </script>
</BaseLayout>
